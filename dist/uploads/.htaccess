# Prevent script execution in uploads directory
Options -ExecCGI
php_flag engine off

# Block PHP execution for mod_php + PHP-FPM/FastCGI
<FilesMatch "\.(php\d?|phtml|pl|py|jsp|asp|sh|cgi)$">
    Require all denied
</FilesMatch>

AddType text/plain .php .php3 .php4 .php5 .phtml .pl .py .jsp .asp .sh .cgi
